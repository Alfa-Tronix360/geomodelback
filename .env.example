# Base de dados (SQLite no MVP; para PostgreSQL troque o URL e instale psycopg)
DATABASE_URL=sqlite:///./geomodel.db

# Segredo do JWT: use um texto longo e aleatório em produção
JWT_SECRET=mudar-este-segredo-em-producao-com-pelo-menos-32-bytes
JWT_EXPIRA_MINUTOS=480

# CORS: lista separada por vírgulas, ou * em desenvolvimento
CORS_ORIGINS=*

# Super administrador criado por scripts/seed.py
ADMIN_EMAIL=admin@clacs.ao
ADMIN_PASSWORD=admin123

# Cria as tabelas automaticamente ao arrancar (útil em desenvolvimento).
# Em produção use `alembic upgrade head` e defina AUTO_CRIAR_TABELAS=false.
AUTO_CRIAR_TABELAS=true

AMBIENTE=desenvolvimento
